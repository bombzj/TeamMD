generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(cuid()) @db.VarChar(30)
  email            String       @db.VarChar(320)
  normalizedEmail  String       @unique @db.VarChar(320)
  passwordHash     String       @db.VarChar(512)
  emailVerifiedAt  DateTime?    @db.DateTime(3)
  sessionEpoch     Int          @default(0)
  createdAt        DateTime     @default(now()) @db.DateTime(3)
  updatedAt        DateTime     @updatedAt @db.DateTime(3)
  disabledAt       DateTime?    @db.DateTime(3)
  sessions         Session[]
  auditEvents       AuditEvent[]
  folders           Folder[]
  documents         Document[]
  documentRevisions DocumentRevision[]
  documentAccesses  DocumentAccess[]   @relation("AccessRecipient")
  accessGrants      DocumentAccess[]   @relation("AccessGrantor")
  collaborationTickets CollaborationTicket[]

  @@index([disabledAt])
}

model Session {
  id               String    @id @default(cuid()) @db.VarChar(30)
  userId           String    @db.VarChar(30)
  tokenHash        String    @unique @db.Char(64)
  csrfTokenHash    String    @db.Char(64)
  sessionEpoch     Int
  expiresAt        DateTime  @db.DateTime(3)
  lastSeenAt       DateTime  @default(now()) @db.DateTime(3)
  revokedAt        DateTime? @db.DateTime(3)
  userAgentSummary String?   @db.VarChar(255)
  ipPrefixHash     String?   @db.Char(64)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborationTickets CollaborationTicket[]

  @@index([userId, revokedAt, expiresAt])
}

model AuditEvent {
  id        String   @id @default(cuid()) @db.VarChar(30)
  actorId   String?  @db.VarChar(30)
  action    String   @db.VarChar(80)
  result    String   @db.VarChar(40)
  requestId String   @db.VarChar(100)
  metadata  Json?
  createdAt DateTime @default(now()) @db.DateTime(3)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Folder {
  id            String    @id @default(cuid()) @db.VarChar(30)
  ownerId       String    @db.VarChar(30)
  parentId      String?   @db.VarChar(30)
  name          String    @db.VarChar(255)
  normalizedName String   @db.VarChar(255)
  parentKey     String    @db.VarChar(30)
  activeNameKey String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)
  trashedAt     DateTime? @db.DateTime(3)
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent        Folder?   @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children      Folder[]  @relation("FolderChildren")
  documents     Document[]

  @@unique([ownerId, parentKey, activeNameKey])
  @@index([ownerId, parentId, trashedAt])
}

model Document {
  id                String             @id @default(cuid()) @db.VarChar(30)
  ownerId           String             @db.VarChar(30)
  folderId          String?            @db.VarChar(30)
  name              String             @db.VarChar(255)
  normalizedName    String             @db.VarChar(255)
  parentKey         String             @db.VarChar(30)
  activeNameKey     String?            @db.VarChar(255)
  currentRevisionId String?            @db.VarChar(30)
  createdAt         DateTime           @default(now()) @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @db.DateTime(3)
  trashedAt         DateTime?          @db.DateTime(3)
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder            Folder?            @relation(fields: [folderId], references: [id], onDelete: Restrict)
  revisions         DocumentRevision[]
  accesses          DocumentAccess[]
  collaborationState CollaborationState?
  collaborationTickets CollaborationTicket[]
  publicLink        DocumentPublicLink?

  @@unique([ownerId, parentKey, activeNameKey])
  @@index([ownerId, folderId, trashedAt])
  @@index([currentRevisionId])
}

enum DocumentAccessRole {
  EDITOR
  VIEWER
}

model DocumentAccess {
  documentId String             @db.VarChar(30)
  userId      String             @db.VarChar(30)
  role        DocumentAccessRole
  grantedById String             @db.VarChar(30)
  createdAt   DateTime           @default(now()) @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @db.DateTime(3)
  document    Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User               @relation("AccessRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User               @relation("AccessGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([documentId, userId])
  @@index([userId, role, updatedAt])
  @@index([grantedById])
}

model DocumentRevision {
  id                     String             @id @default(cuid()) @db.VarChar(30)
  documentId             String             @db.VarChar(30)
  ordinal                Int
  authorId               String             @db.VarChar(30)
  content                String             @db.LongText
  byteSize               Int
  contentHash            String             @db.Char(64)
  saveMessage            String?            @db.VarChar(500)
  restoredFromRevisionId String?            @db.VarChar(30)
  createdAt              DateTime           @default(now()) @db.DateTime(3)
  document               Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author                 User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  restoredFrom           DocumentRevision?  @relation("RevisionRestore", fields: [restoredFromRevisionId], references: [id], onDelete: SetNull)
  restoredAs             DocumentRevision[] @relation("RevisionRestore")

  @@unique([documentId, ordinal])
  @@index([authorId, createdAt])
  @@index([restoredFromRevisionId])
}

model CollaborationTicket {
  id         String    @id @default(cuid()) @db.VarChar(30)
  tokenHash  String    @unique @db.Char(64)
  documentId String    @db.VarChar(30)
  sessionId  String    @db.VarChar(30)
  userId     String    @db.VarChar(30)
  expiresAt  DateTime  @db.DateTime(3)
  consumedAt DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId, expiresAt])
  @@index([sessionId, consumedAt])
}

model CollaborationState {
  documentId          String   @id @db.VarChar(30)
  generation          Int      @default(1)
  yjsState             Bytes    @db.LongBlob
  checkpointRevisionId String   @db.VarChar(30)
  updatedAt            DateTime @updatedAt @db.DateTime(3)
  document             Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model DocumentPublicLink {
  documentId String   @id @db.VarChar(30)
  tokenHash  String   @unique @db.Char(64)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}